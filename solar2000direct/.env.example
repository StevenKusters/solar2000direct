# ---------------------------------------------------------------------------
# solar2000direct configuration. Copy to .env and edit.
# Only S2D_INVERTER_HOST is required.
# ---------------------------------------------------------------------------

# --- Inverter ---------------------------------------------------------------
S2D_INVERTER_HOST=192.168.1.50
S2D_INVERTER_PORT=502
# 1 = inverter behind an SDongle, 0 = inverter's own WiFi AP. Run s2d-probe if unsure.
S2D_INVERTER_UNIT_ID=1
S2D_INVERTER_TIMEOUT=10
# Seconds between Modbus requests. Raise toward 0.5 if the device drops the connection.
S2D_INVERTER_COOLDOWN=0.05

S2D_SITE_NAME=Home
S2D_LOG_LEVEL=INFO

# --- Polling ----------------------------------------------------------------
# A live pass is 3 Modbus round-trips. Measured cost is ~1.06 s per round-trip during
# production and roughly half that after dark, so 4 s leaves room for the other tiers.
# A tier that overruns stretches its own schedule rather than falling behind.
S2D_LIVE_INTERVAL=4
S2D_SLOW_INTERVAL=60
S2D_PACK_INTERVAL=300
# Per-panel data is a Modbus file read, measured at ~6 s, and it holds the bus throughout.
S2D_OPTIMIZER_INTERVAL=300
S2D_OPTIMIZER_ENABLED=true

# --- HTTP -------------------------------------------------------------------
S2D_HTTP_PORT=8480
# The routes that write to the inverter answer ONLY on this second port. As an add-on it
# is the one Home Assistant's ingress connects to and is never mapped onto the host. In
# plain Docker nothing publishes it unless you add it to docker-compose.yml yourself --
# do that only if you want the control API reachable, because nothing authenticates it.
S2D_HTTP_INGRESS_PORT=8099

# --- MQTT / Home Assistant discovery ----------------------------------------
S2D_MQTT_HOST=192.168.1.10
S2D_MQTT_PORT=1883
S2D_MQTT_USERNAME=
S2D_MQTT_PASSWORD=
S2D_MQTT_BASE_TOPIC=solar2000direct
S2D_MQTT_DISCOVERY_PREFIX=homeassistant

# --- Reading the P1 meter back out of Home Assistant -------------------------
# The P1 port is USB-attached to the HA machine, so HA is the only thing that can read
# it. Comparing it against the Huawei CT-clamp meter is how a reversed clamp is found.
# Create the token at Profile -> Security -> Long-lived access tokens.
S2D_HA_URL=http://192.168.1.10:8123
S2D_HA_TOKEN=
S2D_HA_POLL_INTERVAL=10
S2D_HA_P1_NET_POWER=sensor.p1_meter_active_power
S2D_HA_P1_PHASE_IMPORT=sensor.p1_meter_active_power_l1_imported,sensor.p1_meter_active_power_l2_imported,sensor.p1_meter_active_power_l3_imported
S2D_HA_P1_PHASE_EXPORT=sensor.p1_meter_active_power_l1_exported,sensor.p1_meter_active_power_l2_exported,sensor.p1_meter_active_power_l3_exported
S2D_HA_P1_IMPORT_ENERGY=sensor.p1_meter_energy_import_tariff_1,sensor.p1_meter_energy_import_tariff_2
# The low-tariff subset. Day import is the remainder, so no separate day list is needed.
S2D_HA_P1_IMPORT_ENERGY_LOW=sensor.p1_meter_energy_import_tariff_1
S2D_HA_P1_ACTIVE_TARIFF=sensor.p1_meter_active_tariff
S2D_HA_P1_EXPORT_ENERGY=sensor.p1_meter_energy_export_tariff_1,sensor.p1_meter_energy_export_tariff_2
# Quarter-hour demand, which a capacity tariff bills on.
S2D_HA_P1_CURRENT_DEMAND=sensor.p1_meter_active_demand_current_quarter_hour
S2D_HA_P1_PEAK_DEMAND=sensor.p1_meter_active_demand_maximum_demand_current_month

# --- History ----------------------------------------------------------------
S2D_HISTORY_ENABLED=true
S2D_HISTORY_PATH=/data/history.sqlite
S2D_HISTORY_FULL_DAYS=1
S2D_HISTORY_MINUTE_DAYS=90

# --- Tariff -----------------------------------------------------------------
# Self-consumed solar is worth the retail price you did not pay; exported solar is worth
# the feed-in rate. Leave the price at 0 to omit money figures entirely.
S2D_ENERGY_PRICE_PER_KWH=0.2450
S2D_LOW_TARIFF_PRICE_PER_KWH=0.2100
# Distribution, transmission and levies per imported kWh, excluding VAT. On many bills
# this is comparable to the energy itself, so leaving it at 0 understates import.
S2D_NETWORK_COST_PER_KWH=0.0850
S2D_NETWORK_COST_LOW_PER_KWH=0
S2D_VAT_PCT=21
S2D_FEED_IN_PRICE_PER_KWH=0.0500
S2D_CURRENCY=EUR
# Belgium's capaciteitstarief bills on peak demand rather than energy, so shaving a peak
# is worth money even at a fixed energy price. Set to 0 to disable the estimate.
S2D_CAPACITY_TARIFF_PER_KW_YEAR=0

# --- Array layout -----------------------------------------------------------
# Panels per MPPT, in string order. Without this, comparing strings is meaningless:
# a bigger string produces more, which says nothing about panel health.
S2D_STRING_PANEL_COUNTS=8,12
S2D_STRING_LABELS=South,West
# Which string the optimizers are on. Optimizers are often fitted to only part of an
# array, so their count is not the panel count.
S2D_OPTIMIZER_STRING=0

# --- Control (writes to the inverter) ---------------------------------------
# Off by default and inert without a password. Writing to a grid-connected inverter is
# not something to enable by accident. Keep the password here, never in the repository.
S2D_CONTROL_ENABLED=false
# Profiles are stored next to the history database, in /data.
S2D_CONTROL_USERNAME=installer
S2D_CONTROL_PASSWORD=

# --- added since: the code reads these, so a Docker user should see them ---------
S2D_MQTT_ENABLED=true
S2D_MQTT_DISCOVERY_PREFIX=homeassistant
S2D_PANEL_WATTS=430
S2D_BACKUP_PRESENT=auto
# P1 meters that publish no signed total (Home Assistant's DSMR integration)
S2D_HA_P1_IMPORT_POWER=
S2D_HA_P1_EXPORT_POWER=
# P1 meters reporting each phase as one signed value (HomeWizard)
S2D_HA_P1_PHASE_POWER=
# Reverse this if your meter is wired the other way round -- the dashboard warns when the
# house load it derives comes out negative, which is the symptom.
S2D_GRID_IMPORT_IS_POSITIVE=false
# Bind address for the JSON API. 0.0.0.0 outside Home Assistant, where there is no ingress.
S2D_HTTP_HOST=0.0.0.0
